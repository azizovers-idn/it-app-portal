# Salin file ini menjadi `.env` bila ingin mengubah konfigurasi.
# Semua variabel bersifat opsional.

# Port server (Flask lokal / gunicorn)
PORT=5000

# Aktifkan debug mode (JANGAN di produksi)
FLASK_DEBUG=true

# Timeout probe status per aplikasi (detik)
CHECK_TIMEOUT=5

# Lama cache hasil cek status (detik)
STATUS_CACHE_TTL=60

# Jumlah thread paralel saat cek status
MAX_WORKERS=16

# Verifikasi sertifikat SSL. Set false jika aplikasi internal memakai
# sertifikat self-signed.
VERIFY_TLS=false
