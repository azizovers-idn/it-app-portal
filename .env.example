# Salin file ini menjadi `.env` bila ingin mengubah konfigurasi.
# Semua variabel bersifat opsional.

# Port server (Flask lokal / gunicorn)
PORT=5000

# Aktifkan debug mode (JANGAN di produksi)
FLASK_DEBUG=true

# Timeout probe status per aplikasi (detik)
CHECK_TIMEOUT=5

# Lama cache hasil cek status (detik)
STATUS_CACHE_TTL=60

# Jumlah thread paralel saat cek status
MAX_WORKERS=16

# Verifikasi sertifikat SSL (default: true / aman).
# JANGAN jadikan false hanya demi mengatasi cert internal.
# Untuk aplikasi internal, gunakan opsi per-aplikasi di data.json:
# "ca_bundle": "/path/corporate-ca.pem"  (disarankan, verifikasi tetap aktif)
# "verify_tls": false                    (khusus aplikasi tersebut saja)
VERIFY_TLS=true
